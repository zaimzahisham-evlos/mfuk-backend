PROJECT_NAME=FastAPI Starter
DEBUG=False

POSTGRES_DB="your_postgresql_db"
POSTGRES_USER="your_postgresql_user"
POSTGRES_PASSWORD="your_postgresql_password"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
TEST_DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@test_db:5432/${POSTGRES_DB}"

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0

# you can generate a random secret key running in the terminal: 
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-secret-key" 
ALGORITHM="HS256"

ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
CORS_ORIGINS='["*"]'